# Local Netlify / Neon env vars
# Copy to .env and fill in, or set in Netlify UI → Site settings → Environment variables

DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
ADMIN_SECRET=change-me-to-a-long-random-string
SYNK_ADMIN_USERNAME=synk-admin
SYNK_ADMIN_PASSWORD_HASH=salt:hash-from-scripts/generate-synk-admin-credentials.js
SYNK_ADMIN_TOTP_SECRET=BASE32SECRETFROMGENERATOR
SYNK_ADMIN_SESSION_SECRET=change-me-to-another-long-random-string
# Bootstrap admin is copied into the synk_admins table on first login.
# After that, change passwords / add admins in Synk Admin → Settings.
# Optional: Synk Business portal session signing (falls back to SYNK_ADMIN_SESSION_SECRET)
# SYNK_BUSINESS_SESSION_SECRET=change-me-business-session-secret
# Preconnected Visitor Sign-In business portal login (optional password bootstrap)
# SYNK_VISITOR_BUSINESS_EMAIL=visitor-signin@synk.local
# SYNK_VISITOR_BUSINESS_PASSWORD=choose-a-strong-password
# Optional legacy signing fallback (no longer used for login):
# SYNK_ADMIN_SECRET=

# Synk join decision emails (Resend)
# RESEND_API_KEY=
# SYNK_EMAIL_FROM=Synk <noreply@yourdomain.com>
